@* Tegnede produktbilleder. Kind svarer til Product.Slug.
   Har du rigtige fotos, kan du erstatte <ProductArt /> i ProductCard.razor
   med <img src="img/produkter/…" alt="…" />.

   Bemærk: SVG'ens <text> skrives med hjælperen SvgText nedenfor, fordi Razor
   bruger <text> til sit eget formål inde i en @@switch. *@

<div class="product-art">
    <svg viewBox="0 0 240 150" role="img" aria-label="@Label">
        @switch (Kind)
        {
            case "stander":
                <ellipse cx="116" cy="139" rx="54" ry="5" fill="#0d1b2a" opacity=".12" />
                <path d="M150 116 L178 136 L150 136 Z" fill="#c3d1e2" />
                <rect x="62" y="12" width="108" height="124" rx="8" fill="#16263a" />

                <g stroke-width="3" stroke-linecap="round">
                    <path d="M72 15.5h28" stroke="#ea4335" />
                    <path d="M104 15.5h28" stroke="#fbbc05" />
                    <path d="M136 15.5h24" stroke="#34a853" />
                    <path d="M65.5 24v42" stroke="#4285f4" />
                    <path d="M65.5 72v44" stroke="#34a853" />
                    <path d="M166.5 24v42" stroke="#ea4335" />
                    <path d="M166.5 72v44" stroke="#fbbc05" />
                    <path d="M72 132.5h28" stroke="#34a853" />
                    <path d="M104 132.5h28" stroke="#4285f4" />
                    <path d="M136 132.5h24" stroke="#ea4335" />
                </g>

                @SvgText(116, 35, "pa-title", "Del din oplevelse")

                <g fill="none" stroke-width="4.5" stroke-linecap="round">
                    <path d="M116 46a21 21 0 0 1 21 21" stroke="#4285f4" />
                    <path d="M137 67a21 21 0 0 1-21 21" stroke="#34a853" />
                    <path d="M116 88a21 21 0 0 1-21-21" stroke="#fbbc05" />
                    <path d="M95 67a21 21 0 0 1 21-21" stroke="#ea4335" />
                </g>
                <g fill="none" stroke="#dce8f4" stroke-width="1.7" stroke-linecap="round">
                    <rect x="112" y="57" width="13" height="20" rx="3.5" />
                    <path d="M106 60a11 11 0 0 1 0 14" />
                </g>

                @Stars(85, 96, 1)

                <line x1="74" y1="116" x2="158" y2="116" stroke="#2f4d70" stroke-width="1.2" />
                @SvgText(116, 127, "pa-foot", "POWERED BY RATENOW")
                break;

            case "kort":
                <ellipse cx="120" cy="137" rx="48" ry="5" fill="#0d1b2a" opacity=".12" />

                <g transform="rotate(-11 106 76)" opacity=".5">
                    <rect x="70" y="24" width="72" height="104" rx="7" fill="#0f1e30" />
                </g>

                <g transform="rotate(5 124 72)">
                    <rect x="86" y="16" width="76" height="112" rx="8" fill="#16263a" />
                    <g stroke-width="2.6" stroke-linecap="round">
                        <path d="M94 19.5h24" stroke="#ea4335" />
                        <path d="M122 19.5h32" stroke="#fbbc05" />
                        <path d="M89.5 27v32" stroke="#4285f4" />
                        <path d="M89.5 64v34" stroke="#34a853" />
                        <path d="M158.5 27v32" stroke="#34a853" />
                        <path d="M158.5 64v34" stroke="#fbbc05" />
                    </g>

                    @SvgText(124, 32, "pa-sub", "Del din oplevelse")

                    <g fill="none" stroke-width="3.4" stroke-linecap="round">
                        <path d="M124 45a13 13 0 0 1 13 13" stroke="#4285f4" />
                        <path d="M137 58a13 13 0 0 1-13 13" stroke="#34a853" />
                        <path d="M124 71a13 13 0 0 1-13-13" stroke="#fbbc05" />
                        <path d="M111 58a13 13 0 0 1 13-13" stroke="#ea4335" />
                    </g>
                    <rect x="120" y="51.5" width="8" height="13" rx="2.4"
                          fill="none" stroke="#dce8f4" stroke-width="1.4" />

                    @Stars(104.8, 80, 0.62)

                    @SvgText(124, 100, "pa-sub", "Tap & bedøm os")

                    <path d="M86 110h76v10a8 8 0 0 1-8 8h-60a8 8 0 0 1-8-8Z" fill="#ffffff" />
                    @SvgText(124, 122, "pa-foot pa-foot--dark", "POWERED BY RATENOW")
                </g>
                break;

            case "klistermaerke":
                <ellipse cx="120" cy="138" rx="46" ry="5" fill="#0d1b2a" opacity=".12" />

                <g fill="none" stroke-width="9" stroke-linecap="round">
                    <path d="M120 18a54 54 0 0 1 54 54" stroke="#4285f4" />
                    <path d="M174 72a54 54 0 0 1-54 54" stroke="#34a853" />
                    <path d="M120 126a54 54 0 0 1-54-54" stroke="#fbbc05" />
                    <path d="M66 72a54 54 0 0 1 54-54" stroke="#ea4335" />
                </g>
                <circle cx="120" cy="72" r="47" fill="#16263a" />

                @SvgText(120, 44, "pa-sub", "Del din oplevelse")

                <g fill="none" stroke-width="3.6" stroke-linecap="round">
                    <path d="M120 55a13 13 0 0 1 13 13" stroke="#4285f4" />
                    <path d="M133 68a13 13 0 0 1-13 13" stroke="#34a853" />
                    <path d="M120 81a13 13 0 0 1-13-13" stroke="#fbbc05" />
                    <path d="M107 68a13 13 0 0 1 13-13" stroke="#ea4335" />
                </g>
                <rect x="116" y="61.5" width="8" height="13" rx="2.4"
                      fill="none" stroke="#dce8f4" stroke-width="1.4" />

                @Stars(100.8, 88, 0.62)

                @SvgText(120, 105, "pa-sub", "Tap & bedøm os")
                break;

            default:
                <ellipse cx="120" cy="137" rx="46" ry="5" fill="#0d1b2a" opacity=".12" />
                <rect x="86" y="18" width="68" height="112" rx="9" fill="#16263a"
                      stroke="#4a6a91" stroke-width="1.6" stroke-dasharray="6 5" />

                <g fill="#8fb4e0" transform="translate(120 62) scale(1.5) translate(-12 -12)">
                    <path d="m12 3 2 5.1 5.1 2-5.1 2-2 5.1-2-5.1-5.1-2 5.1-2L12 3Z" />
                </g>
                <g fill="#fbbc05" transform="translate(139 90) scale(1.1) translate(-12 -12)">
                    <path d="m12 6 1.3 3.4 3.4 1.3-3.4 1.3L12 15.4l-1.3-3.4L7.3 10.7l3.4-1.3L12 6Z" />
                </g>

                @SvgText(120, 104, "pa-sub", "Jeres eget design")

                <circle cx="103" cy="117" r="5" fill="#ea4335" />
                <circle cx="115" cy="117" r="5" fill="#fbbc05" />
                <circle cx="127" cy="117" r="5" fill="#34a853" />
                <circle cx="139" cy="117" r="5" fill="#4285f4" />
                break;
        }
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = "Produktillustration";

    private const string StarPath =
        "m5 0 1.55 3.15 3.45.5-2.5 2.45.6 3.45L5 7.9 1.9 9.55l.6-3.45L0 3.65l3.45-.5L5 0Z";

    /// <summary>Et &lt;text&gt;-element i SVG'en, centreret om x.</summary>
    private static RenderFragment SvgText(double x, double y, string cssClass, string content) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", Num(x));
        builder.AddAttribute(2, "y", Num(y));
        builder.AddAttribute(3, "class", cssClass);
        builder.AddContent(4, content);
        builder.CloseElement();
    };

    /// <summary>Fem stjerner side om side med start i (x, y).</summary>
    private static RenderFragment Stars(double x, double y, double scale) => builder =>
    {
        builder.OpenElement(0, "g");
        builder.AddAttribute(1, "fill", "#fbbc05");
        builder.AddAttribute(2, "transform", $"translate({Num(x)} {Num(y)}) scale({Num(scale)})");

        for (var i = 0; i < 5; i++)
        {
            builder.OpenElement(3 + i * 3, "path");
            builder.AddAttribute(4 + i * 3, "transform", $"translate({i * 13} 0)");
            builder.AddAttribute(5 + i * 3, "d", StarPath);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static string Num(double value) =>
        value.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
