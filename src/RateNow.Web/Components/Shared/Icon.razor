@* Samlet ikonsæt. Brug: <Icon Name="check" Size="18" /> *@

@if (Name == "star")
{
    <svg class="@Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="m12 2.6 2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.45 6.2 20.5l1.1-6.45L2.6 9.45l6.5-.95L12 2.6Z" />
    </svg>
}
else
{
    <svg class="@Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        @switch (Name)
        {
            case "check":
                <path d="M20 6 9 17l-5-5" />
                break;

            case "check-circle":
                <circle cx="12" cy="12" r="9" />
                <path d="m8.2 12.2 2.6 2.6 5-5.6" />
                break;

            case "arrow-right":
                <path d="M4.5 12h15" />
                <path d="m13.5 6 6 6-6 6" />
                break;

            case "mail":
                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                <path d="m3.8 7 8.2 5.6L20.2 7" />
                break;

            case "phone":
                <path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H8l1.8 4.4-2.2 1.4a12.5 12.5 0 0 0 5.6 5.6l1.4-2.2L19 14v2.5A1.5 1.5 0 0 1 17.5 18C10.6 18 4 11.4 4 4.5Z" />
                break;

            case "clock":
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7.2V12l3.4 2" />
                break;

            case "map-pin":
                <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" />
                <circle cx="12" cy="10" r="2.6" />
                break;

            case "tap":
                <path d="M8 6.5a8 8 0 0 1 0 11" />
                <path d="M11.6 9a4.4 4.4 0 0 1 0 6" />
                <path d="M15.2 11.2a1.2 1.2 0 0 1 0 1.6" />
                break;

            case "stand":
                <rect x="3.5" y="3" width="17" height="12.5" rx="2.5" />
                <path d="M12 15.5V21" />
                <path d="M8 21h8" />
                break;

            case "card":
                <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
                <path d="M2.5 10h19" />
                <path d="M6 14.5h4" />
                break;

            case "sticker":
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6l6-6V5a2 2 0 0 0-2-2Z" />
                <path d="M13 21v-4a2 2 0 0 1 2-2h4" />
                break;

            case "custom":
                <path d="m11 3 1.7 4.3L17 9l-4.3 1.7L11 15l-1.7-4.3L5 9l4.3-1.7L11 3Z" />
                <path d="m17.5 14.5.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1Z" />
                break;

            case "no-subscription":
                <circle cx="12" cy="12" r="9" />
                <path d="m8.2 15.8 7.6-7.6" />
                break;

            case "own":
                <path d="M12 3 5 6v5.6c0 4.2 2.9 7.6 7 9.4 4.1-1.8 7-5.2 7-9.4V6l-7-3Z" />
                <path d="m9.2 12.2 2 2 3.6-4" />
                break;

            case "help":
                <path d="M4 13.5v-1.4a8 8 0 0 1 16 0v1.4" />
                <rect x="2.5" y="13" width="4" height="6" rx="1.8" />
                <rect x="17.5" y="13" width="4" height="6" rx="1.8" />
                break;

            case "honest":
                <path d="M20.5 11.8a7.8 7.8 0 0 1-11.3 7L4 20.5l1.7-5.2a7.8 7.8 0 1 1 14.8-3.5Z" />
                break;

            case "truck":
                <rect x="2.5" y="6" width="11.5" height="9.5" rx="1.5" />
                <path d="M14 9.5h3.6L21 12.7v2.8h-7" />
                <circle cx="7" cy="17.8" r="1.7" />
                <circle cx="17" cy="17.8" r="1.7" />
                break;

            case "shield":
                <path d="M12 3 5 6v5.6c0 4.2 2.9 7.6 7 9.4 4.1-1.8 7-5.2 7-9.4V6l-7-3Z" />
                break;

            case "chart":
                <path d="M4 20h16" />
                <path d="M7 20v-6" />
                <path d="M12 20V6" />
                <path d="M17 20v-9" />
                break;

            default:
                <circle cx="12" cy="12" r="9" />
                break;
        }
    </svg>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string? Class { get; set; }
}
