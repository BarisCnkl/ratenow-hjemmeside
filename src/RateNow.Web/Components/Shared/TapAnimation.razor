@* Animeret scene: telefonen føres hen til standeren, NFC-bølgerne slår ud,
   og skærmen skifter til anmeldelsessiden. Alt sker i CSS — se .ta-* i app.css.
   Brugere med "reducér bevægelse" slået til får et stillbillede af slutresultatet. *@

<svg class="tap-anim @Class" viewBox="0 0 430 420" role="img"
     aria-label="En telefon holdes op til NFC-standeren, og anmeldelsessiden åbner med fem stjerner">
    <defs>
        <linearGradient id="ta-glow" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#2a5b93" stop-opacity=".55" />
            <stop offset="100%" stop-color="#0d1b2a" stop-opacity="0" />
        </linearGradient>
        <path id="ta-star-path"
              d="m14 0 4.3 8.7 9.7 1.4-7 6.8 1.6 9.6L14 22l-8.6 4.5 1.6-9.6-7-6.8 9.7-1.4L14 0Z" />
    </defs>

    <circle cx="195" cy="185" r="175" fill="url(#ta-glow)" />

    <!-- Standeren -->
    <g>
        <rect x="48" y="40" width="250" height="300" rx="18" fill="#152a42" stroke="#2f4d70" stroke-width="2" />

        <g stroke-width="6" stroke-linecap="round">
            <path d="M68 42h56" stroke="#ea4335" />
            <path d="M134 42h56" stroke="#fbbc05" />
            <path d="M200 42h56" stroke="#34a853" />
            <path d="M50 70v54" stroke="#4285f4" />
            <path d="M296 70v54" stroke="#34a853" />
            <path d="M50 140v54" stroke="#ea4335" />
            <path d="M296 140v54" stroke="#fbbc05" />
        </g>

        <text x="173" y="86" text-anchor="middle" fill="#e8f0f9"
              font-family="system-ui, sans-serif" font-size="19" font-weight="600">Del din oplevelse</text>

        <g fill="none" stroke-width="7" stroke-linecap="round">
            <path d="M173 118a60 60 0 0 1 60 60" stroke="#4285f4" />
            <path d="M233 178a60 60 0 0 1-60 60" stroke="#34a853" />
            <path d="M173 238a60 60 0 0 1-60-60" stroke="#fbbc05" />
            <path d="M113 178a60 60 0 0 1 60-60" stroke="#ea4335" />
        </g>

        <circle class="ta-ping" cx="173" cy="178" r="54" fill="none" stroke="#7fb0ff" stroke-width="3" />

        <g fill="none" stroke="#dce8f4" stroke-width="3" stroke-linecap="round">
            <path d="M156 158a26 26 0 0 1 0 36" />
            <path d="M168 167a13 13 0 0 1 0 18" />
            <rect x="180" y="152" width="26" height="46" rx="6" />
        </g>

        <g fill="#fbbc05" transform="translate(96 256) scale(0.82)">
            <use href="#ta-star-path" x="0" />
            <use href="#ta-star-path" x="40" />
            <use href="#ta-star-path" x="80" />
            <use href="#ta-star-path" x="120" />
            <use href="#ta-star-path" x="160" />
        </g>

        <line x1="70" y1="302" x2="276" y2="302" stroke="#2f4d70" stroke-width="1.5" />
        <text x="173" y="324" text-anchor="middle" fill="#8fa8c2"
              font-family="system-ui, sans-serif" font-size="11.5" letter-spacing="1.4">POWERED BY RATENOW</text>
    </g>

    <!-- Signalbølger -->
    <g fill="none" stroke="#7fb0ff" stroke-width="3.5" stroke-linecap="round">
        <path class="ta-wave ta-wave--1" d="M268 254a34 34 0 0 1 0 56" />
        <path class="ta-wave ta-wave--2" d="M254 240a54 54 0 0 1 0 84" />
        <path class="ta-wave ta-wave--3" d="M240 226a74 74 0 0 1 0 112" />
    </g>

    <!-- Telefonen -->
    <g class="ta-phone">
        <g transform="rotate(-8 340 300)">
            <rect x="288" y="182" width="118" height="212" rx="22" fill="#0a1421" stroke="#3b5d84" stroke-width="2" />
            <rect x="296" y="190" width="102" height="196" rx="16" fill="#132638" />
            <rect x="326" y="196" width="42" height="7" rx="3.5" fill="#0a1421" />

            <!-- Låseskærm, før tryk -->
            <g class="ta-screen-home">
                <text x="347" y="252" text-anchor="middle" fill="#5c7a9c"
                      font-family="system-ui, sans-serif" font-size="27" font-weight="600">09:41</text>
                <rect x="312" y="300" width="70" height="8" rx="4" fill="#1e3550" />
            </g>

            <!-- Anmeldelsessiden, efter tryk -->
            <g class="ta-screen-review">
                <text x="347" y="234" text-anchor="middle" fill="#9fc0e6"
                      font-family="system-ui, sans-serif" font-size="13" font-weight="600">Google</text>

                <g fill="#fbbc05" transform="translate(312 244) scale(0.5)">
                    <use class="ta-star ta-star--1" href="#ta-star-path" x="0" />
                    <use class="ta-star ta-star--2" href="#ta-star-path" x="38" />
                    <use class="ta-star ta-star--3" href="#ta-star-path" x="76" />
                    <use class="ta-star ta-star--4" href="#ta-star-path" x="114" />
                    <use class="ta-star ta-star--5" href="#ta-star-path" x="152" />
                </g>

                <rect x="308" y="278" width="78" height="9" rx="4.5" fill="#24405c" />
                <rect x="308" y="296" width="58" height="9" rx="4.5" fill="#24405c" />
                <rect x="308" y="326" width="78" height="26" rx="13" fill="#1a73e8" />
            </g>
        </g>
    </g>
</svg>

@code {
    [Parameter] public string? Class { get; set; }
}
